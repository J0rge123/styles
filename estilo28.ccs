#menu {
  font-family: Arial;
}

#menu p {
  margin:0px;
  padding:0px;
}

#menu a {
  display: block;
  padding: 3px;
  width: 160px;
  background-color: #c6d312;
  border-bottom: 1px solid #0ab9c5;
  text-align:center;
}

#menu a:link, #menu a:visited {
  color: #00ff2a;
  text-decoration: none;
}

#menu a:hover {
  background-color: #336699;
  color: #ffffff;
}